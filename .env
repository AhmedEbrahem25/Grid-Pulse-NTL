# Copy to .env and adjust. docker-compose reads these.
INGEST_TOKEN=dev-token          # bearer token the Edge Node must send to /ingest
INLINE_DETECTION=true           # true = API runs detection; false = Celery worker does
REDIS_URL=redis://localhost:6379/0
RESIDUAL_ALERT_W=400            # unexplained watts above the AI baseline before we suspect theft
HEALTHY_PF=0.92                 # power factor below this (unexplained) is suspicious
